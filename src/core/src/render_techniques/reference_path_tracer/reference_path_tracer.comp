uint2 g_BufferDimensions;
RayCamera g_RayCamera;
uint g_BounceCount;
uint g_BounceRRCount;
uint g_SampleCount;
uint g_Accumulate;

uint g_FrameIndex;

// --- Foveation parameters ---
float2 g_GazePoint;
float  g_FoveaRadius;
float  g_MidRadius;
uint   g_FoveatedEnabled;
float  g_AspectRatio;

uint g_FoveaSPP;
uint g_MidSPP;
uint g_PeripherySPP;


