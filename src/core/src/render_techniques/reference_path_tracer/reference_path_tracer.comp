#include "components/light_sampler/light_sampler.hlsl"
#include "ray_tracing/path_tracing.hlsl"

uint GetFoveationStride(float dist)
{
    if (dist > g_MidRadius)
    {
        return 4;
    }
    if (dist > g_FoveaRadius)
    {
        return 2;
    }
    return 1;
}

float GetFoveationDistance(float2 uv)
{
    float2 delta = uv - g_GazePoint;
    delta.x *= g_AspectRatio;
    return length(delta);
}

uint2 ClampPixel(int2 pixel, uint2 dimensions)
{
    return uint2(clamp(pixel, int2(0, 0), int2(dimensions)-1));
}

// Nearest reconstruction 
// sol-üst anchor'ından direkt kopyalar 
float4 SampleNearestAnchor(uint2 pixel, uint stride, uint2 dimensions)
{
    int2 anchorOrigin = (int2(pixel) / int(stride)) * int(stride);
    uint2 ap = ClampPixel(anchorOrigin, dimensions);

    float2 apUV = (float2(ap) + 0.5f) / float2(dimensions);
    uint apStride = GetFoveationStride(GetFoveationDistance(apUV));
    ap = (ap / apStride) * apStride;

    return g_OutputBuffer[ap];
}


// Gaussian-weighted fill from a 3x3 grid 
float4 SampleFoveatedGaussian(uint2 pixel, uint stride, uint2 dimensions)
{
    int2 anchorOrigin = (int2(pixel) / int(stride)) * int(stride);

    float  sigma2    = float(stride * stride);
    float4 colorSum  = 0.0f;
    float  weightSum = 0.0f;

    
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            uint2 ap = ClampPixel(anchorOrigin + int2(dx, dy) * int(stride), dimensions);

         
            float2 apUV = (float2(ap) + 0.5f) / float2(dimensions);
            uint   apStride = GetFoveationStride(GetFoveationDistance(apUV));
            ap = (ap / apStride) * apStride;

            float2 delta = float2(int2(ap) - int2(pixel));
            float  w     = exp(-0.5f * dot(delta, delta) / sigma2);
            colorSum  += g_OutputBuffer[ap] * w;
            weightSum += w;
        }
    }
    
    if (weightSum <= 0.0f)
    {
        return float4(0, 0, 0, 0);
    }else
    {
        return colorSum / weightSum;
    }

    
}

/**
 * Calculate illumination information for a specific pixel
 * @note This writes a single sample per pixel directly to the output buffer
 * @param pixel      The current pixel.
 * @param dimensions The maximum pixel dimensions.
 */
void pathTracer(in uint2 pixel, in uint2 dimensions)
{
    // Setup configurable constants
    const uint minBounces = g_BounceRRCount; //Minimum bounces before early terminations are allowed
    const uint maxBounces = g_BounceCount;

    //Check if valid pixel
    if (any(pixel >= dimensions))
    {
        return;
    }

    uint maxSamples = g_SampleCount;

    // ── FOVEATION START ──
    if (g_FoveatedEnabled != 0)
    {
        float2 uv = (float2(pixel) + 0.5f) / float2(dimensions);
        float dist = GetFoveationDistance(uv);
        uint stride = GetFoveationStride(dist);

        if ((pixel.x % stride != 0) || (pixel.y % stride != 0))
        {
            return; // filled in FoveationFill pass
        }

        // Bölgeye göre SPP seç 
        if (dist > g_MidRadius)        
            maxSamples = g_PeripherySPP;
        else if (dist > g_FoveaRadius) 
            maxSamples = g_MidSPP;
        else                           
            maxSamples = g_FoveaSPP;
    }
    // ── FOVEATION END ──

    

    // AMD'NIN PATH TRACING ALGORITMASI VE WELFORDS ONLINE ALGORITMASI
    const uint id = pixel.x + pixel.y * dimensions.x;

    // Offset pixel to pixel center
    float2 pixelRay = pixel;
    pixelRay += 0.5f;

    // Initialise per-pixel path tracing values
    float3 radiance = 0.0f;

    // Loop over requested number of samples per pixel
    for (uint sample = 0; sample < maxSamples; )
    {
        // Intialise random number sampler
        const uint frameID = g_FrameIndex * g_SampleCount + sample;
        Random randomNG = MakeRandom(id, frameID);

        // Calculate jittered pixel position
        StratifiedSampler randomStratified = MakeStratifiedSampler(id, frameID);
        float2 newPixelRay = pixelRay + lerp(-0.5.xx, 0.5.xx, randomStratified.rand2());

        // Calculate primary ray
        RayInfo ray = generateCameraRay(newPixelRay, g_RayCamera);

        float3 pathRadiance = 0.0f.xxx;
        traceFullPath(ray, randomStratified, randomNG, minBounces, maxBounces, pathRadiance);
            
        if (any(isnan(pathRadiance)) || any(isinf(pathRadiance)) || any(pathRadiance < 0.0f))
        pathRadiance = 0.0f.xxx;

        // Calculate running average of samples (Welfords online algorithm)
        radiance = radiance + ((pathRadiance - radiance) / (float)++sample);
    }

    if (any(isnan(radiance)) || any(isinf(radiance)))
    {
        radiance = 0.0f.xxx;
    }
    radiance = max(radiance, 0.0f.xxx);
    
    // AMD'NIN ACCUMULATION ALGORITMASI
    // Accumulate previous samples
    if (g_Accumulate != 0)
    {
        // Get previous values
        float4 accumulator = g_AccumulationBuffer[pixel];
        uint previousCount = asuint(accumulator.w);
        // Increment sample count
        uint sampleCount = previousCount + maxSamples;
        // Calculate running average (Welfords online algorithm using Chans parallel algorithm when maxSamples > 1)
        radiance = accumulator.xyz + (((radiance - accumulator.xyz) * (float)maxSamples) / (float)sampleCount);
        // Write out new radiance and sample count to accumulation buffer
        g_AccumulationBuffer[pixel] = float4(radiance, asfloat(sampleCount));
    }
    else
    {
        // Write out current value so its ready for next frame
        g_AccumulationBuffer[pixel] = float4(radiance, asfloat(maxSamples));
    }

    // Output average accumulation
    g_OutputBuffer[pixel] = float4(radiance, 1.0f);
}

#if USE_INLINE_RT
[numthreads(4, 8, 1)]
void ReferencePT(in uint2 did : SV_DispatchThreadID)
{
    pathTracer(did, g_BufferDimensions);
}


#endif

// Fill  pixels 
[numthreads(8, 8, 1)]
void FoveationFill(in uint2 did : SV_DispatchThreadID)
{
    uint2 pixel = did;
    if (any(pixel >= g_BufferDimensions))
    {
        return;    }
    if (g_FoveatedEnabled == 0)
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5f) / float2(g_BufferDimensions);
    uint stride = GetFoveationStride(GetFoveationDistance(uv));

    if ((pixel.x % stride == 0) && (pixel.y % stride == 0))
    {
        return; // Anchor pixel
    }

    float4 filled = SampleFoveatedGaussian(pixel, stride, g_BufferDimensions);
    //float4 filled = SampleNearestAnchor(pixel, stride, g_BufferDimensions);
       
    
    g_OutputBuffer[pixel] = float4(filled.xyz, 1.0f);
    g_AccumulationBuffer[pixel] = float4(filled.xyz, asfloat(1u)); 
}

